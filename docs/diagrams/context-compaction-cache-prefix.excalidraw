   "id": "tfoot2",
   "type": "text",
   "x": 40,
   "y": 545,
   "width": 998.4,
   "height": 20.0,
   "roundness": null,
   "text": "when the next request starts with the same bytes. A per-request sliding window guarantees it never does.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "when the next request starts with the same bytes. A per-request sliding window guarantees it never does.",
