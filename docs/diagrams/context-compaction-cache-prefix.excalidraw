   "id": "tfoot",
   "type": "text",
   "x": 40,
   "y": 520,
   "width": 969.5999999999999,
   "height": 20.0,
   "roundness": null,
   "text": "The moving breakpoint (prompt_cache_http.rs) marks the last message of each request; it only pays off",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The moving breakpoint (prompt_cache_http.rs) marks the last message of each request; it only pays off",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "angle": 0,
   "strokeColor": "#757575",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
