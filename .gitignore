# Rust build artifacts
/target
**/target/
crates/chatty-module-sdk/Cargo.lock
**.DS_Store
*.db
**/libs/

# Local cargo target-dir overrides (machine-specific, never commit)
/.cargo/
**/.cargo/config.toml

# WASM module build outputs (built by CI)
modules/**/*.wasm
# ...except the core-module fixture, which cargo cannot build (see its .wat).
!modules/fixtures/core-module/core_module.wasm

# A module CI generates from templates/module each run to prove the
# template still builds (AGE-600); never a real module to commit.
/modules/ci-generated/

# AppImage build artifacts
/squashfs-root
appimagetool-*.AppImage

# Build output and artifacts
*.dmg
*.app
*.tar.gz
chatty.app/
chatty-*.dmg

# Backup and temporary files
*.backup
*.bak
*~

# Documentation artifacts (should be in docs/ if needed)
REFACTORING_SUMMARY.md
TEST_SUMMARY.md

# mdBook build output and synced copies (source: docs/, AGENTS.md, crates/*/README.md)
/docs-site/book/
/docs-site/src/dev/architecture/
/docs-site/src/dev/adrs/
/docs-site/src/dev/research/
/docs-site/src/dev/reference/
/docs-site/src/dev/crates/
/docs-site/src/dev/agents.md
/docs-site/src/assets/
/docs/generated/

# Inspiration/reference code (should be external)
/inspiration/

.claude/*
!.claude/skills/

# Backup files
*.bak
*.bak[0-9]
*.backup
*.backup[0-9]
*.old
