// A hand-written stand-in for the retired `chatty:module@0.1.0` world: the
// same agent export, under the old package version, so the host's 0.2.0
// linker cannot find `chatty:module/agent@0.2.0` and must say so.
package chatty:module@0.1.0;

interface agent {
    get-agent-card: func() -> string;
}

world module {
    export agent;
}
